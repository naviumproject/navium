--- a/chrome/browser/ui/webui/version/version_ui.cc
+++ b/chrome/browser/ui/webui/version/version_ui.cc
@@ -40,6 +40,23 @@ std::string GetVersionString() {
   return version_ui_strings;
 }
 
+std::string GetNaviumVersion() {
+  std::string navium_version = "0.0.3";
+#ifdef NAVIUM_VERSION_FILE
+  base::FilePath version_file(NAVIUM_VERSION_FILE);
+  if (base::PathExists(version_file)) {
+    if (base::ReadFileToString(version_file, &navium_version)) {
+      base::TrimWhitespaceASCII(navium_version, base::TRIM_ALL, &navium_version);
+    }
+  }
+#endif
+  return navium_version;
+}
+
   void VersionUIDataSource::StartDataRequest() {
     source->AddString("version", GetVersionString());
+    source->AddString("navium_version", GetNaviumVersion());
   }
