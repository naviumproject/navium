+class NaviumReadmeDataSource : public content::URLDataSource {
+ public:
+  std::string GetSource() override { return "readme"; }
+
+  std::string GetMimeType(const GURL& url) override {
+    std::string path = url.path();
+    if (base::EndsWith(path, ".png", base::CompareCase::INSENSITIVE_ASCII))
+      return "image/png";
+    if (base::EndsWith(path, ".jpg", base::CompareCase::INSENSITIVE_ASCII) ||
+        base::EndsWith(path, ".jpeg", base::CompareCase::INSENSITIVE_ASCII))
+      return "image/jpeg";
+    if (base::EndsWith(path, ".gif", base::CompareCase::INSENSITIVE_ASCII))
+      return "image/gif";
+    if (base::EndsWith(path, ".svg", base::CompareCase::INSENSITIVE_ASCII))
+      return "image/svg+xml";
+    return "text/html; charset=utf-8";
+  }
+
+  std::string GetContentSecurityPolicy(network::mojom::CSPDirectiveName directive) override {
+    if (directive == network::mojom::CSPDirectiveName::ScriptSrc)
+      return "script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src nav: data: 'self';";
+    return std::string();
+  }
+
+  void StartDataRequest(const GURL& url,
+                        const content::WebContents::Getter& wc_getter,
+                        GotDataCallback callback) override {
+    std::string path = url.path();
+    if (path.rfind("/assets/", 0) == 0) {
+      std::string asset_rel = path.substr(strlen("/assets/"));
+      base::FilePath asset_path = ResolveReadmeAssetPath(asset_rel);
+      std::string data;
+      if (base::ReadFileToString(asset_path, &data)) {
+        std::move(callback).Run(
+            base::MakeRefCounted<base::RefCountedBytes>(reinterpret_cast<const unsigned char*>(data.data()), data.size()));
+        return;
+      }
+      std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>("<h1>Asset not found</h1>"));
+      return;
+    }
+
+    std::string html = MarkdownToHtml(ReadReadmeFile());
+    std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(std::move(html)));
+  }
+};
+
+class NaviumReadme;
+class NaviumReadmeUIConfig : public content::DefaultWebUIConfig<NaviumReadme> {
+ public:
+  NaviumReadmeUIConfig() : DefaultWebUIConfig("nav", "readme") {}
+};
+
+class NaviumReadme : public content::WebUIController {
+ public:
+  explicit NaviumReadme(content::WebUI* web_ui)
+      : content::WebUIController(web_ui) {
+    content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                                std::make_unique<NaviumReadmeDataSource>());
+  }
+  NaviumReadme(const NaviumReadme&) = delete;
+  NaviumReadme& operator=(const NaviumReadme&) = delete;
+};
+
